@@ -0,0 +1,88 @@
+"""Offline browser regression: labels, legacy links, destination permissions and paging.
+Run: python tests/slides-navigation.py (Python Playwright + /usr/bin/chromium).
+"""
+from functools import partial
+from http.server import SimpleHTTPRequestHandler, ThreadingHTTPServer
+from pathlib import Path
+from threading import Thread
+from playwright.sync_api import sync_playwright
+
+ROOT = Path(__file__).resolve().parents[1]
+
+class QuietHandler(SimpleHTTPRequestHandler):
+    def log_message(self, *_):
+        pass
+
+STUB = """
+window.supabase={createClient:()=>({
+  auth:{getSession:async()=>({data:{session:null}}),onAuthStateChange:()=>({data:{subscription:{unsubscribe(){}}}})},
+  from:()=>{const q=new Proxy({}, {get:(_,k)=>k==='then' ? (a,b)=>Promise.resolve({data:[],error:null}).then(a,b) : ()=>q});return q;}
+})};
+"""
+
+server = ThreadingHTTPServer(('127.0.0.1', 0), partial(QuietHandler, directory=str(ROOT)))
+thread = Thread(target=server.serve_forever, daemon=True)
+thread.start()
+try:
+    with sync_playwright() as pw:
+        browser = pw.chromium.launch(executable_path='/usr/bin/chromium', args=['--no-sandbox'])
+        page = browser.new_page()
+        errors = []
+        page.on('pageerror', lambda error: errors.append(str(error)))
+        def route(request):
+            if request.request.url.startswith(f'http://127.0.0.1:{server.server_port}/'):
+                request.continue_()
+            elif '@supabase/supabase-js' in request.request.url:
+                request.fulfill(body=STUB, content_type='application/javascript')
+            else:
+                request.fulfill(body='', content_type='application/javascript')
+        page.route('**/*', route)
+        page.goto(f'http://127.0.0.1:{server.server_port}/', wait_until='networkidle')
+        assert not errors, errors
+        result = page.evaluate("""async () => {
+          const assert=(ok,label)=>{if(!ok)throw Error(label)};
+          SITE_USER_PROFILE={role:'admin',permissions:{}};
+          document.body.classList.remove('site-locked');
+          for(const slide of SLIDES){
+            const panel=document.getElementById(slide.id);
+            assert(+panel.dataset.logicalSlide===slide.number,'DOM mapping '+slide.number);
+            assert(document.querySelector(`.stab[data-s="${slide.number}"]`).textContent.trim()===String(slide.number).padStart(2,'0')+' '+slide.title,'menu label');
+            if(slide.number){
+              assert(document.querySelector(`.home-card[data-slide-access="${slide.number}"] .home-card-title`).textContent===slide.title,'home label');
+              assert(panel.querySelector(':scope > .slide-header .slide-title').textContent.trim()===String(slide.number).padStart(2,'0')+' '+slide.title,'panel label');
+              assert(getDashboardSlideRegistry().find(s=>s.n===slide.number).title===slide.title,'permission label');
+            }
+          }
+          assert(!document.querySelector('#s2,#s4,#s8'),'dead panels removed');
+          for(const [old,destination] of [[2,6],[9,6],[4,10]]){
+            goSlide(old);assert(CURRENT_SLIDE===destination,'redirect');
+            assert(document.querySelectorAll('.slide.active').length===1,'single active panel');
+            assert(+localStorage.getItem(ACTIVE_TAB_STORAGE_KEY)===destination,'saved canonical number');
+          }
+          for(const [hash,destination] of [['#s2',6],['#s8',6],['#s9',10],['#s11',7],['#slide=9',6],['#slide-4',10]]){
+            location.hash=hash;restoreActiveTab();assert(CURRENT_SLIDE===destination,'legacy hash '+hash);
+          }
+          assert(requestedSlideFromHash('#access_token=abc&type=recovery')===null,'auth hash untouched');
+          location.hash='';localStorage.setItem(ACTIVE_TAB_STORAGE_KEY,'9');restoreActiveTab();assert(CURRENT_SLIDE===6,'saved legacy tab');
+          goSlide(8);document.querySelector('#s7 .pager-btns .pg-btn:last-child').click();assert(CURRENT_SLIDE===10,'next skips removed slide');
+          document.querySelector('#s9 .pager-btns .pg-btn:first-child').click();assert(CURRENT_SLIDE===8,'back skips removed slide');
+          assert(document.getElementById('admin-setting-count').textContent.includes('5টি'),'five settings');
+          assert(document.querySelector('[data-slide-label="7"]').textContent.includes(SLIDES.find(s=>s.number===7).title),'modal label');
+          renderS4StrengthSettings();assert(document.getElementById('admin-setting-panel-title').textContent.includes(slideLabel(10)),'admin panel label');
+          await loadSiteUsers();assert(document.getElementById('site-users-head').textContent.includes('07 '+SLIDES.find(s=>s.number===7).title),'user module headers');
+          SITE_USER_PROFILE={role:'user',permissions:{slide_2:true,slide_9:true,slide_4:true}};
+          for(const old of [2,9,4]){goSlide(old);assert(CURRENT_SLIDE===0,'legacy permission cannot bypass destination');}
+          SITE_USER_PROFILE.permissions={slide_1:true,slide_6:true};applySitePermissions();
+          goSlide(1);document.dispatchEvent(new KeyboardEvent('keydown',{key:'ArrowRight'}));assert(CURRENT_SLIDE===6,'keyboard skips denied modules');
+          goSlide(2);assert(CURRENT_SLIDE===6,'destination permission permits alias');
+          assert(getUserPermissionKeys().includes('admin_settings')&&!getUserPermissionKeys().includes('slide_2'),'stable active permission keys');
+          return SLIDES.length;
+        }""")
+        page.wait_for_timeout(200)
+        assert not errors, errors
+        print(f'PASS {result} central slide mappings, labels, modal/admin text, redirects, saved tabs, permissions and paging')
+        browser.close()
+finally:
+    server.shutdown()
+    server.server_close()
+    thread.join()
diff --git a/tests/chassis-slide10-access.sql b/tests/chassis-slide10-access.sql
new file mode 100644
index 0000000..d22be69
--- /dev/null
+++ b/tests/chassis-slide10-access.sql
@@ -0,0 +1,61 @@
+-- Transactional live RLS regression; restores every temporary fixture change.
+-- Requires an existing Auth-linked admin; never creates or sends an Auth account.
+begin;
+select set_config('request.jwt.claim.sub', (select auth_user_id::text from public.site_users where role='admin' and auth_user_id is not null limit 1), true);
+select set_config('ekwl.test.chassis_rows', (select count(*)::text from public.slide4_chassis_strength), true);
+do $$ begin
+  if auth.uid() is null then raise exception 'Auth-linked admin fixture required'; end if;
+  if current_setting('ekwl.test.chassis_rows')::int=0 then raise exception 'Nonempty chassis table required'; end if;
+end $$;
+
+update public.site_users set role='user', status='active', permissions='{"slide_10": true}'::jsonb where auth_user_id=auth.uid();
+set local role authenticated;
+do $$ begin
+  if (select count(*) from public.slide4_chassis_strength) <> current_setting('ekwl.test.chassis_rows')::int then raise exception 'slide10 chassis RLS failed'; end if;
+end $$;
+reset role;
+
+update public.site_users set role='user', status='active', permissions='{}'::jsonb where auth_user_id=auth.uid();
+set local role authenticated;
+do $$ begin
+  if (select count(*) from public.slide4_chassis_strength) <> 0 then raise exception 'denied chassis RLS failed'; end if;
+end $$;
+reset role;
+
+update public.site_users set role='user', status='disabled', permissions='{"slide_10": true}'::jsonb where auth_user_id=auth.uid();
+set local role authenticated;
+do $$ begin
+  if (select count(*) from public.slide4_chassis_strength) <> 0 then raise exception 'disabled chassis RLS failed'; end if;
+end $$;
+reset role;
+
+update public.site_users set role='admin', status='active', permissions='{}'::jsonb where auth_user_id=auth.uid();
+set local role authenticated;
+do $$ begin
+  if (select count(*) from public.slide4_chassis_strength) <> current_setting('ekwl.test.chassis_rows')::int then raise exception 'admin chassis RLS failed'; end if;
+end $$;
+reset role;
+
+update public.site_users set role='user', status='active', permissions='{"slide_4": true}'::jsonb where auth_user_id=auth.uid();
+set local role authenticated;
+do $$ begin
+  if (select count(*) from public.slide4_chassis_strength) <> current_setting('ekwl.test.chassis_rows')::int then raise exception 'legacy4 chassis RLS failed'; end if;
+end $$;
+reset role;
+
+update public.site_users set role='user', status='active', permissions='{"admin_settings": true}'::jsonb where auth_user_id=auth.uid();
+set local role authenticated;
+do $$ begin
+  if (select count(*) from public.slide4_chassis_strength) <> current_setting('ekwl.test.chassis_rows')::int then raise exception 'settings chassis RLS failed'; end if;
+end $$;
+reset role;
+
+set local role anon;
+do $$ begin
+  if has_table_privilege(current_user,'public.slide4_chassis_strength','SELECT') then
+    if (select count(*) from public.slide4_chassis_strength) <> 0 then raise exception 'Anonymous chassis rows exposed'; end if;
+  end if;
+end $$;
+reset role;
+rollback;
+select 'PASS: slide10, denied, disabled, admin, legacy4, settings and anon RLS; all fixture changes rolled back' as result;
diff --git a/supabase/migrations/20261012093837_chassis_slide10_read_access.sql b/supabase/migrations/20261012093837_chassis_slide10_read_access.sql
new file mode 100644
index 0000000..4c94534
--- /dev/null
+++ b/supabase/migrations/20261012093837_chassis_slide10_read_access.sql
@@ -0,0 +1,17 @@
+-- Chassis Analysis is logical Slide 10; keep legacy Slide 04 read compatibility.
+alter policy slide4_chassis_strength_read
+on public.slide4_chassis_strength
+to authenticated
+using (
+  exists (
+    select 1 from public.site_users u
+    where u.auth_user_id = (select auth.uid())
+      and lower(u.status::text) = 'active'
+      and (
+        lower(u.role::text) = 'admin'
+        or coalesce(u.permissions ->> 'slide_4', 'false') = 'true'
+        or coalesce(u.permissions ->> 'slide_10', 'false') = 'true'
+        or coalesce(u.permissions ->> 'admin_settings', 'false') = 'true'
+      )
+  )
+);
